flowchart LR
    subgraph Phone["Mobile App (Flutter)"]
        UI["HomeScreen / MapScreen"]
        PP["ProductProvider"]
        REPO["ProductRepository"]
        DB[("SQLite<br/>products")]
        API["ApiService"]
        ORCH["ShoppingOrchestrator"]
        LOC["LocationService"]
        GEO["GeofenceService"]
        GSTATE[("geofence_state.json")]
        NDS["NotificationDecisionService"]
        NOTIF["NotificationService"]
        TRACELET["Tracelet plugin"]
        DBG["DebugFileLogger<br/>(temporary)"]
    end

    subgraph Home["Home server (Docker)"]
        TUNNEL["Cloudflare Tunnel<br/>api.cloudavenue.ro"]
        subgraph BE["Backend (Spring Boot 4, Java 21)"]
            SFC["ShopFinderController<br/>/api/shops/find"]
            PCC["ProductCategoryController<br/>/api/products/*"]
            DLC["DebugLogController<br/>/api/debug/log (temporary)"]
            SFS["ShopFinderServiceImp"]
            WSS["WebSearchServiceImp"]
            OSMS["OpenStreetMap<br/>PhysicalStoreDiscoveryService"]
            PCS["ProductCategoryServiceImp"]
            GPC["GooglePlacesClient"]
            OPC["OpenStreetMapOverpassClient"]
        end
        PG[("PostgreSQL<br/>category dictionary")]
        OVERPASS["Overpass<br/>(Romania extract)"]
    end

    GOOGLE["Google Places API"]

    UI --> PP --> REPO
    REPO --> DB
    REPO --> API
    PP -->|"onProductsChanged"| ORCH
    ORCH --> REPO
    ORCH --> GEO
    LOC --> ORCH
    TRACELET --> LOC
    TRACELET --> GEO
    GEO --> GSTATE
    GEO --> NDS --> NOTIF
    LOC --> UI
    DBG -.-> TUNNEL

    API --> TUNNEL
    TUNNEL --> SFC
    TUNNEL --> PCC
    TUNNEL -.-> DLC
    SFC --> SFS --> WSS
    WSS --> PCS
    PCC --> PCS --> PG
    WSS --> GPC --> GOOGLE
    WSS --> OSMS --> OPC --> OVERPASS
